# ==============================================================================
# ALGO BROKERAGE AUTOMATION & MONITORING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. Broker Selection & URLs
# ------------------------------------------------------------------------------
# Supported brokers: dhan, zerodha
BROKER_NAME=dhan
BROKER_URL=https://web.dhan.co

# ------------------------------------------------------------------------------
# 3. Browser & Profile Settings
# ------------------------------------------------------------------------------
# BROWSER_MODE options:
# - "persistent_profile": Directly opens Chrome using existing user profile folder
# - "cdp": Connects to an already-running Chrome instance via remote debugging
BROWSER_MODE=persistent_profile

# Default Windows Chrome User Data directory:
# C:\Users\<YourUsername>\AppData\Local\Google\Chrome\User Data
CHROME_USER_DATA_DIR=C:\Users\asadu\AppData\Local\Google\Chrome\User Data

# Chrome profile name (Default, Profile 1, Profile 2, etc.)
CHROME_PROFILE_DIR=Default

# Optional custom Chrome executable path (leave empty to use system Chrome)
CHROME_EXECUTABLE_PATH=

# If BROWSER_MODE=cdp, specify the CDP debugging URL
CDP_URL=http://localhost:9222

# Headless mode (Set false to view and interact with the browser)
HEADLESS=false

# ------------------------------------------------------------------------------
# 4. Telegram Notification Settings
# ------------------------------------------------------------------------------
# Set to true to enable Telegram alerts
TELEGRAM_ENABLED=true

# Your Telegram Bot Token obtained from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (user ID, group ID, or channel ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 5. Monitoring & Runtime Settings
# ------------------------------------------------------------------------------
# Polling interval in seconds (do not set below 2 to prevent rate limits)
CHECK_INTERVAL=5

# Page load / navigation timeout in milliseconds
PAGE_TIMEOUT_MS=30000

# Retention period in days for processed events stored in SQLite
EVENT_RETENTION_DAYS=30

# Storage Directories & Database Paths
DATA_DIR=data
DATABASE_PATH=data/events.db

# Logging Settings
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# ------------------------------------------------------------------------------
# 6. Stock Market Screen Analysis Settings
# ------------------------------------------------------------------------------
STOCK_SCANNER_ENABLED=true
STOCK_SCAN_INTERVAL=5
TOP_MOVERS_LIMIT=10
TOP_DECLINERS_LIMIT=10
MIN_CHANGE_PERCENT=0.5

# Telegram Market Alerts
TELEGRAM_MARKET_ALERTS=true
TELEGRAM_MIN_CHANGE_PERCENT=3.0
TELEGRAM_NOTIFICATION_COOLDOWN=60

# Custom CSS Selectors (Optional Overrides)
MARKET_REGION_SELECTOR=
STOCK_ROW_SELECTOR=
SYMBOL_SELECTOR=
PRICE_SELECTOR=
CHANGE_SELECTOR=
CHANGE_PERCENT_SELECTOR=

